# ==========================================
# Windows CPack Configuration (Auto-generated from product_info.json)
# ==========================================
# This file parallels:
#   Windows:  cpack_windows_config.cmake.in → .cmake (ZIP/NSIS package metadata)
#   macOS:    cpack_macos_config.cmake.in   → .cmake (TGZ/DragNDrop package metadata)
#   Linux:    cpack_linux_config.cmake.in   → .cmake (DEB/RPM package metadata)
#
# Template variables are filled by GenerateAppInfoFiles from the same
# product_info.json used by RC and PList generation.
# ==========================================

# ── Common ────────────────────────────────────────────────────────────────
set(CPACK_PACKAGE_NAME          "@PRODUCT_NAME@")
set(CPACK_PACKAGE_VERSION       "@VERSION_MAJOR@.@VERSION_MINOR@.@VERSION_PATCH@.@VERSION_BUILD@")
set(CPACK_PACKAGE_FILE_NAME     "@PRODUCT_NAME@-@VERSION_MAJOR@.@VERSION_MINOR@.@VERSION_PATCH@.@VERSION_BUILD@-Windows")
set(CPACK_PACKAGE_CONTACT       "@COMPANY_NAME@")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "@PRODUCT_DESCRIPTION@")
set(CPACK_PACKAGE_VENDOR        "@COMPANY_NAME@")

# ZIP and NSIS share the same runtime application root. ZIP keeps one
# outer product directory; the executable is directly inside it.
set(CPACK_PACKAGING_INSTALL_PREFIX "/")
if(CPACK_GENERATOR STREQUAL "ZIP")
    set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
endif()

# Keep the installation location and product registration version-independent.
set(CPACK_PACKAGE_INSTALL_DIRECTORY "@PRODUCT_NAME@")
set(CPACK_PACKAGE_INSTALL_REGISTRY_KEY "@PRODUCT_IDENTIFIER@")
set(CPACK_PACKAGE_EXECUTABLES
    "${CPACK_APPLICATION_EXECUTABLE_NAME}" "@PRODUCT_NAME@")

# ── NSIS ──────────────────────────────────────────────────────────────────
set(CPACK_NSIS_DISPLAY_NAME     "@PRODUCT_NAME@ @VERSION_MAJOR@.@VERSION_MINOR@.@VERSION_PATCH@.@VERSION_BUILD@")
set(CPACK_NSIS_PACKAGE_NAME     "@PRODUCT_NAME@")
set(CPACK_NSIS_CONTACT          "@COMPANY_NAME@")
set(CPACK_NSIS_EXECUTABLES_DIRECTORY ".")
set(CPACK_NSIS_INSTALLED_ICON_NAME "${CPACK_APPLICATION_EXECUTABLE_NAME}.exe")

if(CPACK_GENERATOR STREQUAL "NSIS")
    # Version checks must run before any uninstall; CPack's optional prompt runs
    # earlier and allows installation to continue without enforcing our policy.
    set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL OFF)
    set(CPACK_NSIS_UNINSTALL_NAME "Uninstall")
    string(CONCAT CPACK_NSIS_DEFINES
        "!define TT_PRODUCT_ID \"@PRODUCT_IDENTIFIER@\"\n"
        "!define TT_PRODUCT_VENDOR \"@COMPANY_NAME@\"\n"
        "!define TT_PRODUCT_NAME \"@PRODUCT_NAME@\"\n"
        "!define TT_PRODUCT_VERSION \"@VERSION_MAJOR@.@VERSION_MINOR@.@VERSION_PATCH@.@VERSION_BUILD@\"\n"
        "!define TT_APP_EXECUTABLE \"${CPACK_APPLICATION_EXECUTABLE_NAME}.exe\"\n"
        "!define TT_UNINSTALL_EXE \"${CPACK_NSIS_UNINSTALL_NAME}.exe\"\n"
        "!include \"${CPACK_NSIS_POLICY_FILE}\"\n"
    )
    set(CPACK_NSIS_EXTRA_PREINSTALL_COMMANDS "Call TTPrepareInstall")
endif()
