# Keep source and CMake files consistent across platforms. MSVC accepts LF;
# Windows command scripts retain their native line endings.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.hxx text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.ts text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

product/framework/thirdparty/opencv/windows/x64/vc16/bin/*.dll filter=lfs diff=lfs merge=lfs -text
product/framework/thirdparty/opencv/windows/x64/vc16/bin/*.pdb filter=lfs diff=lfs merge=lfs -text
